---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/common/Section.astro';
import Hero from '../components/sections/Hero.astro';
import Projects from '../components/sections/Projects.astro';
import Experience from '../components/sections/Experience.astro';
import Technologies from '../components/sections/Technologies.astro';
import HowIWork from '../components/sections/HowIWork.astro';
import Formation from '../components/sections/Formation.astro';
import Contact from '../components/sections/Contact.astro';
import { profile } from '../data/profile';
---

<BaseLayout title={`${profile.fullName} | ${profile.title}`}>
  <!-- 1. Inicio: Hero integrado, perfil compacto y presentación profesional -->
  <Section id="inicio" class="section-hero">
    <Hero />
  </Section>

  <!-- 2. Proyectos: Casos de estudio técnicos reales (SalesFlow) -->
  <Section id="proyectos" title="Proyectos">
    <Projects />
  </Section>

  <!-- 3. Experiencia: Trayectoria laboral cronológica con jerarquía técnica -->
  <Section id="experiencia" title="Experiencia">
    <Experience />
  </Section>

  <!-- 4. Tecnologías: Stack principal consolidado y categorías secundarias compactas -->
  <Section id="tecnologias" title="Tecnologías">
    <Technologies />
  </Section>

  <!-- 5. Cómo trabajo: Flujo metodológico en 4 fases con IA transversal integrada -->
  <Section id="como-trabajo" title="Cómo trabajo">
    <HowIWork />
  </Section>

  <!-- 6. Formación: Formación académica e idiomas -->
  <Section id="formacion" title="Formación">
    <Formation />
  </Section>

  <!-- 7. Contacto: Canales directos de comunicación profesional -->
  <Section id="contacto" title="Contacto">
    <Contact />
  </Section>
</BaseLayout>

<style>
  .section-hero {
    padding-top: clamp(1.25rem, 3.5vw, var(--space-2xl));
    padding-bottom: clamp(2rem, 4.5vw, var(--space-3xl));
  }
</style>
