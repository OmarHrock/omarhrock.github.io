---
import type { WorkProcessStep } from '../../types/workProcess';

interface Props {
  step: WorkProcessStep;
  index: number;
}

const { step, index } = Astro.props;
const stepNumber = String(index + 1).padStart(2, '0');
---

<li class="process-step">
  <!-- Columna izquierda: Indicador numérico y conector vertical -->
  <div class="step-indicator" aria-hidden="true">
    <div class="step-badge">{stepNumber}</div>
    <div class="step-line"></div>
  </div>

  <!-- Columna derecha: Contenido del paso -->
  <div class="step-content">
    <header class="step-header">
      <h3 class="step-title">{step.title}</h3>
    </header>

    <p class="step-description">{step.description}</p>

    {step.aiAssisted && (
      <div class="step-meta">
        <span class="ai-support-indicator">IA como apoyo</span>
      </div>
    )}
  </div>
</li>

<style>
  .process-step {
    position: relative;
    display: flex;
    gap: var(--space-md);
  }

  /* Conector vertical y distintivo numérico */
  .step-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 32px;
  }

  .step-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    z-index: 1;
  }

  .step-line {
    width: 2px;
    flex-grow: 1;
    background-color: var(--color-border);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-xs);
  }

  .process-step:last-child .step-line {
    display: none;
  }

  /* Contenedor del contenido */
  .step-content {
    flex-grow: 1;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .process-step:last-child .step-content {
    margin-bottom: 0;
  }

  .step-header {
    display: flex;
    align-items: center;
  }

  .step-title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--line-height-tight);
  }

  .step-description {
    font-size: var(--text-sm);
    line-height: var(--line-height-base);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Indicador secundario discreto de IA */
  .step-meta {
    padding-top: var(--space-xs);
  }

  .ai-support-indicator {
    display: inline-block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.5rem;
    font-weight: var(--font-weight-normal);
    letter-spacing: 0.01em;
  }

  @media (max-width: 480px) {
    .process-step {
      gap: var(--space-sm);
    }

    .step-indicator {
      width: 28px;
    }

    .step-badge {
      width: 28px;
      height: 28px;
      font-size: 0.7rem;
    }

    .step-content {
      padding: var(--space-md);
    }
  }
</style>
