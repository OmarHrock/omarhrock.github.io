---
import type { WorkProcessStep } from '../../types/workProcess';

interface Props {
  step: WorkProcessStep;
  index: number;
}

const { step, index } = Astro.props;
const stepNumber = String(index + 1).padStart(2, '0');
---

<li class="process-step">
  <div class="step-top" aria-hidden="true">
    <span class="step-badge">FASE {stepNumber}</span>
    <span class="step-rule"></span>
  </div>

  <div class="step-body">
    <h3 class="step-title">{step.title}</h3>
    <p class="step-description">{step.description}</p>
  </div>
</li>

<style>
  .process-step {
    background: linear-gradient(
      180deg,
      var(--color-bg-surface) 0%,
      var(--color-bg-secondary) 100%
    );
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-fast);
  }

  .process-step:hover {
    border-color: var(--color-border-subtle);
  }

  .step-top {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .step-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-accent);
    font-family: var(--font-family-mono);
    font-size: 0.7rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    flex-shrink: 0;
  }

  .step-rule {
    height: 1px;
    flex-grow: 1;
    background: linear-gradient(
      90deg,
      var(--color-border-subtle) 0%,
      transparent 100%
    );
  }

  .step-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .step-title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--line-height-tight);
    letter-spacing: var(--tracking-normal);
  }

  .step-description {
    font-size: var(--text-sm);
    line-height: var(--line-height-base);
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>
