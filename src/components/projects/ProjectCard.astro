---
import type { Project } from '../../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusLabels: Record<Project['status'], string> = {
  'completed': 'Completado',
  'in-progress': 'En desarrollo',
  'archived': 'Archivado',
  'planned': 'Planificado',
};

const statusText = statusLabels[project.status] ?? 'Proyecto';
const hasImages = Boolean(project.images && project.images.length > 0);
const mainImage = hasImages ? project.images![0] : '';
const imageDimensions: Record<string, { width: number; height: number }> = {
  '/projects/salesflow/dashboard.webp': { width: 1270, height: 909 },
  '/projects/webmap/webmap-dashboard.webp': { width: 1024, height: 458 },
  '/projects/dataflow/02-analiticas.png': { width: 1354, height: 606 },
};
const mainImageMeta = imageDimensions[mainImage] ?? { width: 1270, height: 720 };
const titleId = `project-${project.id}-title`;

interface ResultToken {
  text: string;
  isMetric: boolean;
}

// Resaltado reutilizable para métricas cuantitativas, porcentajes, tiempos y códigos HTTP
const METRIC_SPLIT_REGEX = /(\b(?:HTTP\s+\d{3}|\d+(?:[.,/]\d+)?(?:\s*(?:%|ms|s|x|\+))?)\b)/gi;
const METRIC_TEST_REGEX = /^(?:HTTP\s+\d{3}|\d+(?:[.,/]\d+)?(?:\s*(?:%|ms|s|x|\+))?)$/i;

function tokenizeResultText(text: string): ResultToken[] {
  return text
    .split(METRIC_SPLIT_REGEX)
    .filter((part) => part.length > 0)
    .map((part) => ({
      text: part,
      isMetric: METRIC_TEST_REGEX.test(part),
    }));
}

const architectureBlocks = [
  { index: '01', label: 'Desafío', content: project.problem },
  { index: '02', label: 'Solución', content: project.solution },
  { index: '03', label: 'Rol', content: project.role },
].filter((item): item is { index: string; label: string; content: string } => Boolean(item.content));
---

<article class={`project-card ${hasImages ? 'has-media' : 'no-media'}`} aria-labelledby={titleId}>
  <!-- Bloque superior: Showcase visual + Resumen y Stack -->
  <div class="card-hero-split">
    {hasImages && (
      <figure class="project-media">
        <div class="media-window-bar" aria-hidden="true">
          <div class="window-dots">
            <span class="window-dot"></span>
            <span class="window-dot"></span>
            <span class="window-dot"></span>
          </div>
          <span class="window-label">PREVIEW // DASHBOARD</span>
        </div>
        <div class="media-canvas">
          <img
            src={mainImage}
            alt={`Captura completa de la interfaz de ${project.title}`}
            width={mainImageMeta.width}
            height={mainImageMeta.height}
            loading="lazy"
            decoding="async"
            class="project-image"
          />
        </div>
      </figure>
    )}

    <div class="project-summary-col">
      <header class="card-header">
        <div class="header-top">
          <span class={`status-badge status-${project.status}`}>
            <span class="status-dot" aria-hidden="true"></span>
            {statusText}
          </span>
        </div>

        <h3 id={titleId} class="project-title">{project.title}</h3>
        <p class="project-description">{project.shortDescription}</p>

        {project.context && (
          <p class="project-context">{project.context}</p>
        )}
      </header>

      {project.technologies && project.technologies.length > 0 && (
        <div class="technologies-block">
          <span class="tech-label">Tecnologías aplicadas</span>
          <ul class="tech-list" aria-label={`Tecnologías utilizadas en ${project.title}`}>
            {project.technologies.map((tech) => (
              <li class="tech-item">
                <span class="tech-dot" aria-hidden="true"></span>
                <span>{tech}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>

  <!-- Enfoque de arquitectura: Desafío, Solución y Rol en grilla editorial -->
  {architectureBlocks.length > 0 && (
    <div class="architecture-summary">
      {architectureBlocks.map((block) => (
        <div class="summary-card">
          <div class="summary-card-header">
            <span class="summary-index" aria-hidden="true">{block.index}</span>
            <span class="summary-label">{block.label}</span>
          </div>
          <p class="summary-content">{block.content}</p>
        </div>
      ))}
    </div>
  )}

  <!-- Resultados técnicos validados -->
  {project.results && project.results.length > 0 && (
    <div class="results-section">
      <div class="results-header">
        <h4 class="section-subtitle">Resultados técnicos validados</h4>
        <span class="results-count" aria-hidden="true">
          {String(project.results.length).padStart(2, '0')} ITEMS
        </span>
      </div>
      <ul class="results-grid">
        {project.results.map((result) => (
          <li class="result-item">
            <span class="check-badge" aria-hidden="true">
              <svg class="check-icon" width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M13.3334 4L6.00008 11.3333L2.66675 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="result-text">
              {tokenizeResultText(result).map((token) =>
                token.isMetric ? (
                  <strong class="metric-highlight">{token.text}</strong>
                ) : (
                  token.text
                )
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Acciones / CTAs -->
  {(project.repositoryUrl || project.isRepositoryPrivate || project.demoUrl) && (
    <footer class="card-footer">
      {project.repositoryUrl && !project.isRepositoryPrivate && (
        <a
          href={project.repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-action btn-code"
          aria-label={`Ver código fuente de ${project.title} en GitHub (se abre en nueva pestaña)`}
        >
          <svg class="github-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
          <span>Ver código</span>
          <svg class="external-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4.66669 11.3333L11.3334 4.66667M11.3334 4.66667H5.33335M11.3334 4.66667V10.6667" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      )}
      {project.isRepositoryPrivate && (
        <span
          class="btn-action btn-code is-private"
          aria-label={`Repositorio privado en GitHub para ${project.title}`}
        >
          <svg class="github-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
          <span>Código privado</span>
          <svg class="lock-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="3.5" y="7" width="9" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M5.5 7V5C5.5 3.61929 6.61929 2.5 8 2.5C9.38071 2.5 10.5 3.61929 10.5 5V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
      )}
      {project.demoUrl && (
        <a
          href={project.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-action btn-demo"
          aria-label={`Ver demostración en vivo de ${project.title} (se abre en nueva pestaña)`}
        >
          <span>Ver demo</span>
          <svg class="external-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4.66669 11.3333L11.3334 4.66667M11.3334 4.66667H5.33335M11.3334 4.66667V10.6667" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      )}
    </footer>
  )}
</article>

<style>
  .project-card {
    background: linear-gradient(
      180deg,
      var(--color-bg-surface) 0%,
      var(--color-bg-secondary) 100%
    );
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: clamp(1.15rem, 2.4vw, 1.65rem);
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.35rem);
    box-shadow: var(--shadow-md);
    transition: border-color var(--transition-normal);
  }

  /* Split Layout: Proporción equilibrada entre captura y resumen en Desktop */
  .card-hero-split {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  @media (min-width: 920px) {
    .project-card.has-media .card-hero-split {
      display: grid;
      grid-template-columns: minmax(0, 1.16fr) minmax(0, 0.84fr);
      gap: clamp(1.25rem, 2.4vw, 1.75rem);
      align-items: start;
    }
  }

  /* Ventana de previsualización de la captura (sin recortes, filtros ni deformación) */
  .project-media {
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    background-color: #111113;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }

  .media-window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.8rem;
    background-color: rgba(23, 23, 25, 0.92);
    border-bottom: 1px solid var(--color-border);
  }

  .window-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .window-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-border-subtle);
  }

  .window-dot:first-child {
    background-color: rgba(242, 140, 88, 0.65);
  }

  .window-label {
    font-family: var(--font-family-mono);
    font-size: 0.65rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .media-canvas {
    width: 100%;
    background-color: #111113;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .project-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  /* Columna de Resumen e Identidad del Proyecto */
  .project-summary-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    min-width: 0;
  }

  .card-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .header-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-family-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  .project-title {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-tight);
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .project-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-base);
    margin: 0;
  }

  .project-context {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--line-height-snug);
    padding-left: var(--space-sm);
    border-left: 2px solid var(--color-border-subtle);
    margin: 0;
  }

  /* Tecnologías Aplicadas */
  .technologies-block {
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .tech-label {
    font-family: var(--font-family-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tech-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }

  .tech-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--color-text-muted);
    flex-shrink: 0;
  }

  /* Enfoque de Arquitectura: Desafío, Solución y Rol */
  .architecture-summary {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .architecture-summary {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .summary-card {
    background-color: rgba(23, 23, 25, 0.55);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.8rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .summary-card-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .summary-index {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  .summary-label {
    font-family: var(--font-family-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .summary-content {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.55;
  }

  /* Resultados Técnicos Validados */
  .results-section {
    background-color: rgba(23, 23, 25, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.9rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .results-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-subtitle {
    font-family: var(--font-family-mono);
    font-size: 0.7rem;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .results-count {
    font-family: var(--font-family-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .results-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .results-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.45rem var(--space-md);
    }
  }

  .result-item {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.45;
    padding: 0.1rem 0;
  }

  .check-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background-color: var(--color-accent-subtle);
    border: 1px solid var(--color-accent-border);
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .check-icon {
    display: block;
  }

  /* Énfasis en métricas clave de resultados */
  .metric-highlight {
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
    background-color: rgba(242, 140, 88, 0.12);
    border: 1px solid rgba(242, 140, 88, 0.28);
    border-radius: 4px;
    padding: 0.05rem 0.35rem;
  }

  /* Acciones / Footer */
  .card-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: 0.65rem 1.2rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-sm);
    text-decoration: none;
    min-height: 42px;
    cursor: pointer;
    flex: 1 1 auto;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  @media (min-width: 480px) {
    .btn-action {
      flex: 0 0 auto;
    }
  }

  .btn-action:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-offset);
  }

  .btn-code {
    background-color: var(--color-bg-primary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-sm);
  }

  .btn-code:hover {
    background-color: var(--color-bg-surface-elevated);
    border-color: var(--color-accent);
    color: var(--color-text-primary);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .btn-code.is-private {
    background-color: rgba(23, 23, 25, 0.6);
    color: var(--color-text-muted);
    border-color: var(--color-border);
    box-shadow: none;
    cursor: default;
  }

  .btn-code.is-private:hover {
    background-color: rgba(23, 23, 25, 0.6);
    border-color: var(--color-border);
    color: var(--color-text-muted);
    transform: none;
    box-shadow: none;
  }

  .lock-icon {
    flex-shrink: 0;
    opacity: 0.8;
  }

  .btn-demo {
    background-color: var(--color-accent);
    color: #141210;
    border: 1px solid var(--color-accent);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), var(--shadow-sm);
  }

  .btn-demo:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: #141210;
    transform: translateY(-1px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 6px 18px rgba(242, 140, 88, 0.22);
  }

  .github-icon,
  .external-icon {
    flex-shrink: 0;
  }

  .external-icon {
    opacity: 0.75;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .btn-action:hover .external-icon {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-code:hover,
    .btn-demo:hover,
    .btn-action:hover .external-icon {
      transform: none;
    }
  }
</style>
