---
import type { Project } from '../../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusLabels: Record<Project['status'], string> = {
  'completed': 'Completado',
  'in-progress': 'En desarrollo',
  'archived': 'Archivado',
  'planned': 'Planificado',
};

const statusText = statusLabels[project.status] ?? 'Proyecto';
const hasImages = Boolean(project.images && project.images.length > 0);
const titleId = `project-${project.id}-title`;
---

<article class="project-card" aria-labelledby={titleId}>
  <!-- Encabezado: Metadatos, Título y Descripción -->
  <header class="card-header">
    <div class="header-top">
      <span class={`status-badge status-${project.status}`}>
        <span class="status-dot" aria-hidden="true"></span>
        {statusText}
      </span>
      {project.context && (
        <span class="project-context">{project.context}</span>
      )}
    </div>

    <h3 id={titleId} class="project-title">{project.title}</h3>
    <p class="project-description">{project.shortDescription}</p>
  </header>

  <!-- Imagen opcional (solo se renderiza cuando existen imágenes físicas configuradas) -->
  {hasImages && (
    <figure class="project-media">
      <img
        src={project.images![0]}
        alt={`Captura representativa de ${project.title}`}
        loading="lazy"
        decoding="async"
        class="project-image"
      />
    </figure>
  )}

  <!-- Tecnologías principales (alta escaneabilidad) -->
  {project.technologies && project.technologies.length > 0 && (
    <div class="technologies-block">
      <ul class="tech-list" aria-label={`Tecnologías utilizadas en ${project.title}`}>
        {project.technologies.map((tech) => (
          <li class="tech-item">{tech}</li>
        ))}
      </ul>
    </div>
  )}

  <!-- Resultados técnicos validados (alto impacto para reclutadores) -->
  {project.results && project.results.length > 0 && (
    <div class="results-section">
      <h4 class="section-subtitle">Resultados técnicos validados</h4>
      <ul class="results-grid">
        {project.results.map((result) => (
          <li class="result-item">
            <svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M13.3334 4L6.00008 11.3333L2.66675 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{result}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Enfoque de arquitectura (Problema, Solución y Rol en bloque secundario compacto) -->
  {(project.problem || project.solution || project.role) && (
    <div class="architecture-summary">
      {project.problem && (
        <div class="summary-row">
          <span class="summary-label">Desafío:</span>
          <p class="summary-content">{project.problem}</p>
        </div>
      )}
      {project.solution && (
        <div class="summary-row">
          <span class="summary-label">Solución:</span>
          <p class="summary-content">{project.solution}</p>
        </div>
      )}
      {project.role && (
        <div class="summary-row">
          <span class="summary-label">Rol:</span>
          <p class="summary-content">{project.role}</p>
        </div>
      )}
    </div>
  )}

  <!-- Acciones / CTA único y real -->
  {(project.repositoryUrl || project.demoUrl) && (
    <footer class="card-footer">
      {project.repositoryUrl && (
        <a
          href={project.repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-code"
          aria-label={`Ver código fuente de ${project.title} en GitHub (se abre en nueva pestaña)`}
        >
          <svg class="github-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
          <span>Ver código</span>
        </a>
      )}
      {project.demoUrl && (
        <a
          href={project.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-demo"
          aria-label={`Ver demostración en vivo de ${project.title} (se abre en nueva pestaña)`}
        >
          <span>Ver demo</span>
        </a>
      )}
    </footer>
  )}
</article>

<style>
  .project-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    transition: border-color var(--transition-normal);
  }

  .project-card:hover {
    border-color: var(--color-border-subtle);
  }

  /* Encabezado */
  .card-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .header-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    background-color: rgba(56, 189, 248, 0.1);
    color: var(--color-accent);
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  .project-context {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .project-title {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--line-height-tight);
  }

  @media (min-width: 768px) {
    .project-title {
      font-size: var(--text-2xl);
    }
  }

  .project-description {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-base);
    margin: 0;
    max-width: 75ch;
  }

  /* Media / Imagen opcional */
  .project-media {
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-surface-elevated);
  }

  .project-image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  /* Tecnologías */
  .technologies-block {
    margin: 0;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tech-item {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  /* Resultados técnicos validados */
  .results-section {
    background-color: rgba(10, 14, 23, 0.55);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .section-subtitle {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin: 0;
  }

  .results-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xs) var(--space-lg);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .results-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .result-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .check-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 3px;
  }

  /* Arquitectura / Enfoque secundario */
  .architecture-summary {
    background-color: rgba(17, 24, 39, 0.4);
    border-left: 3px solid var(--color-border-subtle);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: var(--space-sm) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .summary-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  @media (min-width: 640px) {
    .summary-row {
      display: grid;
      grid-template-columns: 85px 1fr;
      gap: var(--space-sm);
      align-items: baseline;
    }
  }

  .summary-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .summary-content {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--line-height-base);
  }

  /* Acciones / Footer */
  .card-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: var(--space-xs);
  }

  .btn-code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: 0.65rem 1.25rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-primary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-subtle);
    text-decoration: none;
    min-height: 44px;
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .btn-code:hover {
    background-color: var(--color-bg-surface-elevated);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn-code:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-offset);
  }

  .github-icon {
    flex-shrink: 0;
  }

  .btn-demo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.25rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-sm);
    background-color: var(--color-accent);
    color: #0b0f19;
    border: 1px solid var(--color-accent);
    text-decoration: none;
    min-height: 44px;
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .btn-demo:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .btn-demo:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-offset);
  }
</style>
