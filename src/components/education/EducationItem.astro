---
import type { Education } from '../../types/education';

interface Props {
  education: Education;
}

const { education } = Astro.props;

let periodDisplay = '';
if (education.startDate && education.endDate) {
  periodDisplay = `${education.startDate} — ${education.endDate}`;
} else if (education.startDate) {
  periodDisplay = education.startDate;
}
---

<article class="education-card">
  <header class="education-header">
    <div class="education-meta-row">
      <span class="institution-name">{education.institution}</span>
      {periodDisplay && (
        <span class="period-badge">{periodDisplay}</span>
      )}
    </div>
    <h4 class="degree-title">{education.degree}</h4>
  </header>
</article>

<style>
  .education-card {
    background: linear-gradient(
      180deg,
      var(--color-bg-surface) 0%,
      var(--color-bg-secondary) 100%
    );
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    box-shadow: var(--shadow-sm);
  }

  .education-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .education-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .institution-name {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    letter-spacing: 0.01em;
  }

  .period-badge {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    background-color: rgba(23, 23, 25, 0.65);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.55rem;
    white-space: nowrap;
  }

  /* El título del programa mantiene máxima jerarquía e importancia visual */
  .degree-title {
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--line-height-snug);
    letter-spacing: var(--tracking-normal);
  }
</style>
