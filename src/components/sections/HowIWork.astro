---
import { workProcess } from '../../data/workProcess';
import WorkProcessStep from '../work-process/WorkProcessStep.astro';

const aiTools = [
  'ChatGPT',
  'Claude',
  'Gemini',
  'NotebookLM',
  'Cursor',
  'Antigravity',
];
---

<div class="how-i-work">
  <!-- 4 fases macro del flujo de desarrollo -->
  <ol class="work-process-list">
    {workProcess.map((step, index) => (
      <WorkProcessStep step={step} index={index} />
    ))}
  </ol>

  <!-- Bloque secundario compacto: IA como apoyo transversal -->
  <aside class="ai-support-block">
    <span id="ai-assisted" class="anchor-target" aria-hidden="true"></span>

    <!-- Encabezado del bloque -->
    <header class="ai-header">
      <span class="ai-eyebrow">APOYO TRANSVERSAL</span>
      <h3 class="ai-title">IA en el flujo de desarrollo</h3>
    </header>

    <!-- Contenido principal: 2 columnas en >= 900px, 1 columna en < 900px -->
    <div class="ai-content-grid">
      <div class="ai-col">
        <span class="col-heading">Alcance técnico</span>
        <p class="ai-description">
          Utilizo herramientas de inteligencia artificial como soporte transversal para optimizar actividades de investigación técnica, análisis, desarrollo, debugging, testing y documentación.
        </p>
      </div>

      <div class="ai-col">
        <span class="col-heading">Herramientas aplicadas</span>
        <ul class="tools-chips" aria-label="Herramientas de IA utilizadas como apoyo">
          {aiTools.map((tool) => (
            <li class="tool-chip">{tool}</li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Supervisión y control humano -->
    <footer class="ai-governance-footer">
      <div class="governance-header">
        <svg class="governance-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 1.5L2 4.5V7.5C2 11.2 4.55 14.65 8 15.5C11.45 14.65 14 11.2 14 7.5V4.5L8 1.5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M6 8L7.5 9.5L10.5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="governance-label">SUPERVISIÓN HUMANA</span>
      </div>
      <p class="governance-text">
        Las decisiones de arquitectura, la revisión de código y la validación final permanecen bajo criterio y supervisión técnica humana.
      </p>
    </footer>
  </aside>
</div>

<style>
  .how-i-work {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 860px;
    gap: var(--space-lg);
  }

  .work-process-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  /* Bloque secundario integrado de IA */
  .ai-support-block {
    position: relative;
    padding: var(--space-md) var(--space-lg);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Anchor de compatibilidad no interactivo */
  .anchor-target {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .ai-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .ai-eyebrow {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .ai-title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--line-height-tight);
  }

  /* Grid de contenido */
  .ai-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    align-items: start;
  }

  @media (min-width: 900px) {
    .ai-content-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  .ai-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .col-heading {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .ai-description {
    font-size: var(--text-sm);
    line-height: var(--line-height-base);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .tools-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tool-chip {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.55rem;
  }

  /* Gobernanza y supervisión humana */
  .ai-governance-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .governance-header {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .governance-icon {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .governance-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .governance-text {
    font-size: var(--text-sm);
    line-height: var(--line-height-base);
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>
