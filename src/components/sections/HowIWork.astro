---
import { workProcess } from '../../data/workProcess';
import WorkProcessStep from '../work-process/WorkProcessStep.astro';
---

<div class="how-i-work">
  <ol class="work-process-list">
    {workProcess.map((step, index) => (
      <WorkProcessStep step={step} index={index} />
    ))}
  </ol>

  <!-- Aclaración global sobre IA (subordinada y de menor jerarquía visual) -->
  <aside class="ai-clarification-note">
    <p class="clarification-text">
      La inteligencia artificial se utiliza como herramienta de apoyo durante determinadas etapas del proceso, manteniendo revisión humana, validación técnica y control sobre las soluciones implementadas.
    </p>
  </aside>
</div>

<style>
  .how-i-work {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 860px;
  }

  .work-process-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .ai-clarification-note {
    margin-top: var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .clarification-text {
    font-size: var(--text-xs);
    line-height: var(--line-height-base);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
