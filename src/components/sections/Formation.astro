---
import { education } from '../../data/education';
import { languages } from '../../data/languages';
import EducationItem from '../education/EducationItem.astro';
---

<div class="formation-container">
  <!-- Bloque principal: Formación académica -->
  <div class="formation-main">
    <div class="block-header">
      <span class="block-index" aria-hidden="true">01</span>
      <h3 class="block-title">Formación académica</h3>
    </div>
    <div class="education-list">
      {education.map((item) => (
        <EducationItem education={item} />
      ))}
    </div>
  </div>

  <!-- Bloque secundario: Idiomas (subordinado como información complementaria) -->
  <div class="formation-secondary">
    <div class="block-header">
      <span class="block-index" aria-hidden="true">02</span>
      <h3 class="block-title">Idiomas</h3>
    </div>
    <div class="languages-list">
      {languages.map((lang) => (
        <div class="language-card">
          <div class="language-name-group">
            <span class="language-dot" aria-hidden="true"></span>
            <span class="language-name">{lang.name}</span>
          </div>
          <span class="language-level">{lang.level}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .formation-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    width: 100%;
  }

  /* Composición asimétrica en pantallas medianas y grandes para priorizar formación académica */
  @media (min-width: 768px) {
    .formation-container {
      display: grid;
      grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: stretch;
    }
  }

  .formation-main,
  .formation-secondary {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .block-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .block-index {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  .block-title {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    margin: 0;
  }

  .education-list,
  .languages-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex-grow: 1;
  }

  /* Fila de idioma ligera, compacta y editorial */
  .language-card {
    background-color: rgba(29, 29, 32, 0.55);
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    flex-grow: 1;
  }

  .language-name-group {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .language-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  .language-name {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .language-level {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    background-color: rgba(23, 23, 25, 0.65);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.6rem;
  }
</style>
