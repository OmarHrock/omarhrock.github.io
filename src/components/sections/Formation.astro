---
import { education } from '../../data/education';
import { languages } from '../../data/languages';
import EducationItem from '../education/EducationItem.astro';
---

<div class="formation-container">
  <!-- Bloque principal: Formación académica -->
  <div class="formation-main">
    <h3 class="block-title">Formación académica</h3>
    <div class="education-list">
      {education.map((item) => (
        <EducationItem education={item} />
      ))}
    </div>
  </div>

  <!-- Bloque secundario: Idiomas (subordinado como información complementaria) -->
  <div class="formation-secondary">
    <h3 class="block-title">Idiomas</h3>
    <div class="languages-list">
      {languages.map((lang) => (
        <div class="language-card">
          <span class="language-name">{lang.name}</span>
          <span class="meta-separator" aria-hidden="true">·</span>
          <span class="language-level">{lang.level}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .formation-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    width: 100%;
    max-width: 860px;
  }

  /* Composición asimétrica en pantallas medianas y grandes para priorizar formación académica */
  @media (min-width: 768px) {
    .formation-container {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: var(--space-xl);
      align-items: start;
    }
  }

  .formation-main,
  .formation-secondary {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .block-title {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin: 0;
  }

  .education-list,
  .languages-list {
    display: flex;
    flex-direction: column;
  }

  /* Tarjeta de idioma complementaria y sobria */
  .language-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .language-name {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .meta-separator {
    color: var(--color-text-muted);
  }

  .language-level {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
</style>
