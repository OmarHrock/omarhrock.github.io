---
import { profile } from '../../data/profile';

const profilePhotoUrl = '/images/profile/omar-arias.webp';
const fsModule = 'node:fs';
const { existsSync } = await import(/* @vite-ignore */ fsModule);
const hasProfilePhoto = Boolean(existsSync('public/images/profile/omar-arias.webp'));
---

<div class:list={['hero', { 'has-photo': hasProfilePhoto }]}>
  <!-- Anchor alias transparente para compatibilidad con enlaces antiguos #perfil -->
  <span id="perfil" class="anchor-target" aria-hidden="true"></span>

  <!-- Columna principal: Identidad, Fotografía (cuando exista), Título, Resumen y Acciones -->
  <div class="hero-main">
    <div class="hero-intro-header">
      {hasProfilePhoto && (
        <figure class="hero-portrait">
          <img
            src={profilePhotoUrl}
            alt={`Fotografía profesional de ${profile.fullName}, ${profile.title}`}
            width="360"
            height="405"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="portrait-image"
          />
        </figure>
      )}

      <div class="hero-title-block">
        <div class="hero-identity">
          <span class="identity-line" aria-hidden="true"></span>
          <p class="hero-name">{profile.fullName}</p>
        </div>

        <h1 class="hero-title">{profile.title}</h1>
      </div>
    </div>

    <p class="hero-summary">{profile.summary}</p>

    <div class="hero-actions">
      <a href="#proyectos" class="btn btn-primary">
        <span>Ver proyectos</span>
        <svg class="btn-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3.33337 8H12.6667M12.6667 8L8.66671 4M12.6667 8L8.66671 12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="#experiencia" class="btn btn-secondary">
        <span>Ver experiencia</span>
      </a>
    </div>
  </div>

  <!-- Columna técnica: Stack principal y Áreas profesionales -->
  <div class="hero-technical">
    <aside class="tech-panel" aria-label="Resumen de especificaciones técnicas">
      <div class="panel-bar" aria-hidden="true">
        <span class="panel-indicator"></span>
        <span class="panel-meta">SPEC // TECH PROFILE</span>
      </div>

      <div class="panel-body">
        <!-- Stack principal -->
        <div class="tech-group">
          <div class="group-header">
            <span class="group-index" aria-hidden="true">01</span>
            <h2 class="group-label">Stack principal</h2>
          </div>
          <ul class="stack-list">
            {profile.mainStack.map((tech) => (
              <li class="stack-item">
                <span class="stack-dot" aria-hidden="true"></span>
                <span class="stack-text">{tech}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Áreas profesionales -->
        <div class="tech-group">
          <div class="group-header">
            <span class="group-index" aria-hidden="true">02</span>
            <h2 class="group-label">Áreas profesionales</h2>
          </div>
          <p class="areas-text">{profile.coreAreas.join(' · ')}</p>
        </div>
      </div>
    </aside>
  </div>
</div>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
  }

  /* Anchor de compatibilidad sin romper flujo ni interferir con accesibilidad */
  .anchor-target {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  /* Composición editorial en 2 columnas para escritorio */
  @media (min-width: 920px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      align-items: center;
      gap: clamp(2.25rem, 4.5vw, 3.75rem);
      padding-top: var(--space-xl);
      padding-bottom: var(--space-xl);
    }
  }

  /* Columna Principal */
  .hero-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-intro-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    width: 100%;
  }

  @media (min-width: 560px) {
    .hero.has-photo .hero-intro-header {
      flex-direction: row;
      align-items: center;
      gap: clamp(1.25rem, 2.8vw, 1.85rem);
    }
  }

  /* Marco editorial para fotografía profesional: mayor presencia y recorte en rostro y hombros */
  .hero-portrait {
    position: relative;
    margin: 0;
    width: 8.5rem;
    aspect-ratio: 4 / 4.5;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-md);
    flex-shrink: 0;
  }

  .hero-portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    pointer-events: none;
  }

  @media (min-width: 560px) {
    .hero-portrait {
      width: 9.75rem;
    }
  }

  @media (min-width: 920px) {
    .hero-portrait {
      width: clamp(10rem, 14.5vw, 11.25rem);
    }
  }

  .portrait-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 16%;
    transform: scale(1.08);
    transform-origin: 50% 18%;
    display: block;
  }

  .hero-title-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .hero-identity {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .identity-line {
    width: 1.75rem;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: 1px;
  }

  .hero-name {
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin: 0;
  }

  /* H1 Único y Dominante con carácter Editorial */
  .hero-title {
    font-size: clamp(2.25rem, 4.8vw, 3.5rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .hero-summary {
    font-size: clamp(1.025rem, 1.35vw, 1.15rem);
    line-height: var(--line-height-base);
    color: var(--color-text-secondary);
    max-width: 56ch;
    margin-bottom: var(--space-xl);
    padding-left: var(--space-md);
    border-left: 2px solid var(--color-border-subtle);
  }

  /* Acciones / Botones de navegación interna */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    width: 100%;
  }

  @media (min-width: 480px) {
    .hero-actions {
      width: auto;
      gap: var(--space-md);
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: 0.75rem 1.4rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.01em;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
    cursor: pointer;
    min-height: 46px;
    flex: 1 1 auto;
  }

  @media (min-width: 480px) {
    .btn {
      flex: 0 0 auto;
    }
  }

  .btn:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-offset);
  }

  .btn-primary {
    background-color: var(--color-accent);
    color: #141210;
    border: 1px solid var(--color-accent);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), var(--shadow-sm);
  }

  .btn-primary:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: #141210;
    transform: translateY(-1px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 6px 18px rgba(242, 140, 88, 0.22);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-icon {
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }

  .btn-primary:hover .btn-icon {
    transform: translateX(2px);
  }

  .btn-secondary {
    background-color: var(--color-bg-surface);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-sm);
  }

  .btn-secondary:hover {
    background-color: var(--color-bg-surface-elevated);
    border-color: var(--color-accent);
    color: var(--color-text-primary);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .btn-secondary:active {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-primary:hover,
    .btn-secondary:hover,
    .btn-primary:hover .btn-icon {
      transform: none;
    }
  }

  /* Columna Técnica: Panel de Especificación Editorial */
  .hero-technical {
    width: 100%;
  }

  .tech-panel {
    background: linear-gradient(
      180deg,
      var(--color-bg-surface) 0%,
      var(--color-bg-secondary) 100%
    );
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .panel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem var(--space-lg);
    background-color: rgba(23, 23, 25, 0.65);
    border-bottom: 1px solid var(--color-border);
  }

  .panel-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-subtle);
  }

  .panel-meta {
    font-family: var(--font-family-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .panel-body {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* En tablet (640px - 919px), aprovechar el ancho horizontal en 2 columnas */
  @media (min-width: 640px) and (max-width: 919px) {
    .panel-body {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-xl);
      align-items: start;
    }
  }

  .tech-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .tech-group + .tech-group {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 640px) and (max-width: 919px) {
    .tech-group + .tech-group {
      padding-top: 0;
      padding-left: var(--space-xl);
      border-top: none;
      border-left: 1px solid var(--color-border);
    }
  }

  .group-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .group-index {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  .group-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Stack Grid Estructurado */
  .stack-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xs);
    padding: 0;
    margin: 0;
  }

  @media (max-width: 359px) {
    .stack-list {
      grid-template-columns: 1fr;
    }
  }

  .stack-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.75rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .stack-item:hover {
    border-color: var(--color-border-subtle);
    background-color: var(--color-bg-surface-elevated);
  }

  .stack-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  .stack-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .areas-text {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--line-height-loose);
    background-color: rgba(23, 23, 25, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.85rem;
    margin: 0;
  }
</style>
