---
import { contactInfo } from '../../data/contact';
import { socialLinks } from '../../data/social';

const linkedIn = socialLinks.find((link) => link.name.toLowerCase() === 'linkedin');
const whatsapp = contactInfo.whatsapp;
---

<div class="contact-container">
  <div class="contact-lead">
    <p class="contact-intro">{contactInfo.introduction}</p>
  </div>

  <div class="contact-channels">
    <!-- Canal 1: Correo Electrónico -->
    <a href={`mailto:${contactInfo.email}`} class="contact-card email-card">
      <div class="channel-top">
        <div class="channel-header">
          <span class="channel-icon-box" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          </span>
          <span class="channel-type">Correo electrónico</span>
        </div>
        <span class="channel-text email-text">{contactInfo.email}</span>
      </div>

      <div class="channel-footer">
        <span class="channel-action">Enviar mensaje</span>
        <svg class="action-icon icon-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3.33337 8H12.6667M12.6667 8L8.66671 4M12.6667 8L8.66671 12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </a>

    <!-- Canal 2: LinkedIn -->
    {linkedIn && (
      <a
        href={linkedIn.url}
        target="_blank"
        rel="noopener noreferrer"
        class="contact-card linkedin-card"
      >
        <div class="channel-top">
          <div class="channel-header">
            <span class="channel-icon-box" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
              </svg>
            </span>
            <span class="channel-type">{linkedIn.name}</span>
          </div>
          <span class="channel-text">Perfil profesional</span>
        </div>

        <div class="channel-footer">
          <span class="channel-action">{linkedIn.label || 'Ver perfil en LinkedIn'}</span>
          <svg class="action-icon icon-external" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4.66669 11.3333L11.3334 4.66667M11.3334 4.66667H5.33335M11.3334 4.66667V10.6667" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>
    )}

    <!-- Canal 3: WhatsApp -->
    {whatsapp && (
      <a
        href={whatsapp.url}
        target="_blank"
        rel="noopener noreferrer"
        class="contact-card whatsapp-card"
        aria-label="Contactar por WhatsApp (se abre en nueva pestaña)"
      >
        <div class="channel-top">
          <div class="channel-header">
            <span class="channel-icon-box" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" />
                <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" />
              </svg>
            </span>
            <span class="channel-type">{whatsapp.label || 'WhatsApp'}</span>
          </div>
          <span class="channel-text">Mensaje directo</span>
        </div>

        <div class="channel-footer">
          <span class="channel-action">{whatsapp.actionLabel || 'Escribirme'}</span>
          <svg class="action-icon icon-external" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4.66669 11.3333L11.3334 4.66667M11.3334 4.66667H5.33335M11.3334 4.66667V10.6667" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>
    )}
  </div>
</div>

<style>
  .contact-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    width: 100%;
  }

  .contact-lead {
    padding-left: var(--space-md);
    border-left: 2px solid var(--color-accent);
  }

  .contact-intro {
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: var(--line-height-base);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .contact-channels {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 600px) and (max-width: 879px) {
    .contact-channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-md);
    }

    .contact-card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 880px) {
    .contact-channels {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-lg);
    }
  }

  .contact-card {
    background: linear-gradient(
      180deg,
      var(--color-bg-surface) 0%,
      var(--color-bg-secondary) 100%
    );
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: clamp(1.25rem, 2.5vw, 1.65rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-lg);
    text-decoration: none;
    min-height: 148px;
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--transition-normal),
      background-color var(--transition-normal),
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .contact-card:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-surface-elevated);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .contact-card:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-offset);
  }

  .channel-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .channel-header {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .channel-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background-color: var(--color-accent-subtle);
    border: 1px solid var(--color-accent-border);
    color: var(--color-accent);
    flex-shrink: 0;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .contact-card:hover .channel-icon-box {
    background-color: var(--color-accent);
    color: #141210;
  }

  .channel-type {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .channel-text {
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-normal);
    color: var(--color-text-primary);
  }

  /* Protección contra desbordamiento en pantallas móviles */
  .email-text {
    font-family: var(--font-family-mono);
    font-size: clamp(0.925rem, 1.35vw, 1.05rem);
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .channel-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .channel-action {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.02em;
    color: var(--color-accent);
    transition: color var(--transition-fast);
  }

  .action-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .contact-card:hover .channel-action,
  .contact-card:hover .action-icon {
    color: var(--color-accent-hover);
  }

  .contact-card:hover .icon-arrow {
    transform: translateX(3px);
  }

  .contact-card:hover .icon-external {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card,
    .channel-icon-box,
    .action-icon {
      transition: none;
    }

    .contact-card:hover,
    .contact-card:hover .icon-arrow,
    .contact-card:hover .icon-external {
      transform: none;
    }
  }
</style>
