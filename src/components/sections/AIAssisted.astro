---
import { aiAssistedData } from '../../data/aiAssisted';
import AIAssistedPractice from '../ai-assisted/AIAssistedPractice.astro';
---

<div class="ai-assisted-container">
  <!-- Copy introductorio -->
  <p class="section-intro">{aiAssistedData.introduction}</p>

  <!-- Grid de prácticas técnicas (dominante visualmente) -->
  <div class="practices-grid">
    {aiAssistedData.practices.map((practice) => (
      <AIAssistedPractice practice={practice} />
    ))}
  </div>

  <!-- Herramientas de apoyo (organizadas conceptualmente por categorías y subordinadas) -->
  <div class="tools-section">
    <h3 class="tools-title">{aiAssistedData.toolsHeading}</h3>

    <div class="tools-categories">
      {aiAssistedData.toolCategories.map((category) => {
        const categoryTools = aiAssistedData.tools.filter((t) => t.category === category.id);
        if (categoryTools.length === 0) return null;

        return (
          <div class="category-group">
            <h4 class="category-title">{category.label}</h4>
            <ul class="tools-list">
              {categoryTools.map((tool) => (
                <li class="tool-item">
                  <div class="tool-header">
                    <span class="tool-badge">{tool.name}</span>
                    {tool.status === 'learning' && (
                      <span class="learning-tag">En aprendizaje</span>
                    )}
                  </div>
                  {tool.usage && <p class="tool-usage">{tool.usage}</p>}
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Declaración de control humano (contenedor neutro de menor jerarquía visual) -->
  <div class="human-control-box">
    <p class="human-control-text">{aiAssistedData.humanControlStatement}</p>
  </div>
</div>

<style>
  .ai-assisted-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    width: 100%;
    max-width: 860px;
  }

  .section-intro {
    font-size: var(--text-base);
    line-height: var(--line-height-loose);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Grid de prácticas profesionales */
  .practices-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .practices-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Bloque de herramientas de apoyo */
  .tools-section {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .tools-title {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin: 0;
  }

  .tools-categories {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .category-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .category-title {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-accent);
    margin: 0;
  }

  .tools-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xs);
  }

  @media (min-width: 640px) {
    .tools-list {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }
  }

  .tool-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-sm) var(--space-md);
  }

  .tool-header {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .tool-badge {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .learning-tag {
    font-size: 0.7rem;
    font-weight: var(--font-weight-normal);
    color: var(--color-text-muted);
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.1rem 0.4rem;
  }

  .tool-usage {
    font-size: var(--text-xs);
    line-height: var(--line-height-base);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Declaración de control humano */
  .human-control-box {
    padding: var(--space-md) var(--space-lg);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .human-control-text {
    font-size: var(--text-xs);
    line-height: var(--line-height-base);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
