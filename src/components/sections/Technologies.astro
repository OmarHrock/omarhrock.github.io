---
import { skills } from '../../data/skills';
import { profile } from '../../data/profile';
import type { SkillCategory } from '../../types/skill';

// Ordenar las tecnologías destacadas respetando exactamente el orden de profile.mainStack
const featuredSkills = profile.mainStack
  .map((techName) => skills.find((s) => s.name === techName && s.featured))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

// Configuración de categorías secundarias (excluyendo las featured para evitar duplicidad visual)
const secondaryCategories: { key: SkillCategory; title: string; index: string }[] = [
  { key: 'development', title: 'Desarrollo', index: '01' },
  { key: 'data', title: 'Datos', index: '02' },
  { key: 'apis-testing', title: 'APIs y testing', index: '03' },
  { key: 'tools-security', title: 'Herramientas y seguridad', index: '04' },
];

// Conocimientos complementarios (Sistemas e infraestructura)
const complementarySkills = skills.filter(
  (s) => s.category === 'systems-infrastructure' && !s.featured
);
---

<div class="technologies-container">
  <!-- 1. Stack principal destacado -->
  <div class="tech-featured-block">
    <div class="featured-header">
      <div class="featured-title-group">
        <span class="featured-eyebrow">CORE STACK</span>
        <h3 class="block-title">Stack principal</h3>
      </div>
      <span class="featured-meta" aria-hidden="true">
        {String(featuredSkills.length).padStart(2, '0')} TECNOLOGÍAS CLAVE
      </span>
    </div>

    <ul class="featured-grid">
      {featuredSkills.map((skill, idx) => (
        <li class="featured-chip">
          <div class="featured-chip-top" aria-hidden="true">
            <span class="featured-index">{String(idx + 1).padStart(2, '0')}</span>
            <span class="featured-dot"></span>
          </div>
          <span class="featured-name">{skill.name}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- 2. Categorías secundarias de desarrollo, datos, APIs y herramientas -->
  <div class="tech-grid">
    {secondaryCategories.map((cat) => {
      const categorySkills = skills.filter(
        (s) => s.category === cat.key && !s.featured
      );
      return (
        <div class="category-card">
          <header class="category-header">
            <span class="category-index" aria-hidden="true">{cat.index}</span>
            <h3 class="category-title">{cat.title}</h3>
          </header>
          <ul class="chips-list">
            {categorySkills.map((skill) => (
              <li class="chip">
                <span class="chip-marker" aria-hidden="true"></span>
                <span>{skill.name}</span>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>

  <!-- 3. Conocimientos complementarios: Sistemas e infraestructura (Jerarquía secundaria) -->
  <div class="complementary-block">
    <div class="complementary-header">
      <span class="complementary-badge">Conocimientos complementarios</span>
      <h3 class="complementary-category-title">Sistemas e infraestructura</h3>
    </div>
    <ul class="chips-list complementary-list">
      {complementarySkills.map((skill) => (
        <li class="complementary-chip">{skill.name}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  .technologies-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* 1. Stack Principal (Protagonismo Editorial) */
  .tech-featured-block {
    background: linear-gradient(
      180deg,
      var(--color-bg-surface) 0%,
      var(--color-bg-secondary) 100%
    );
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: clamp(1.25rem, 2.5vw, 1.65rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    box-shadow: var(--shadow-md);
  }

  .featured-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .featured-title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .featured-eyebrow {
    font-family: var(--font-family-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .block-title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    margin: 0;
  }

  .featured-meta {
    font-family: var(--font-family-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    display: none;
  }

  @media (min-width: 480px) {
    .featured-meta {
      display: inline-block;
    }
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .featured-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-md);
    }
  }

  .featured-chip {
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border-subtle);
    border-top: 2px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .featured-chip:hover {
    background-color: var(--color-bg-surface-elevated);
    border-color: var(--color-accent);
  }

  .featured-chip-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .featured-index {
    font-family: var(--font-family-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .featured-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  .featured-name {
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-normal);
  }

  /* 2. Grid de Categorías Secundarias */
  .tech-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 560px) {
    .tech-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 920px) {
    .tech-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .category-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    box-shadow: var(--shadow-sm);
  }

  .category-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .category-index {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  .category-title {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .chips-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.65rem;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-medium);
  }

  .chip-marker {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--color-border-subtle);
    flex-shrink: 0;
  }

  /* 3. Conocimientos Complementarios: Sistemas e infraestructura (Discreto y Subordinado) */
  .complementary-block {
    background-color: rgba(29, 29, 32, 0.55);
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .complementary-block {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-xl);
    }
  }

  .complementary-header {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex-shrink: 0;
  }

  .complementary-badge {
    font-family: var(--font-family-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .complementary-category-title {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .complementary-list {
    justify-content: flex-start;
  }

  @media (min-width: 768px) {
    .complementary-list {
      justify-content: flex-end;
    }
  }

  .complementary-chip {
    font-family: var(--font-family-mono);
    background-color: rgba(23, 23, 25, 0.65);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.6rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-normal);
  }
</style>
