---
import type { Experience } from '../../types/experience';

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;

// Formatear el periodo respetando las precisiones aprobadas
let periodDisplay = '';
if (experience.current) {
  periodDisplay = `${experience.startDate} — Presente`;
} else if (experience.endDate && experience.startDate !== experience.endDate) {
  periodDisplay = `${experience.startDate} — ${experience.endDate}`;
} else {
  periodDisplay = experience.startDate;
}
---

<article class="experience-item">
  <div class="timeline-indicator" aria-hidden="true">
    <div class="timeline-dot"></div>
    <div class="timeline-line"></div>
  </div>

  <div class="experience-content">
    <header class="experience-header">
      <h3 class="role-title">{experience.role}</h3>
      <p class="company-period">
        <span class="company-name">{experience.company}</span>
        <span class="meta-separator" aria-hidden="true">·</span>
        <span class="period-text">{periodDisplay}</span>
      </p>
    </header>

    {experience.description && experience.description.length > 0 && (
      <ul class="responsibilities-list">
        {experience.description.map((item) => (
          <li class="responsibility-item">{item}</li>
        ))}
      </ul>
    )}

    {experience.technologies && experience.technologies.length > 0 && (
      <div class="technologies-container">
        <span class="technologies-label">Tecnologías aplicadas:</span>
        <ul class="tech-chips">
          {experience.technologies.map((tech) => (
            <li class="tech-chip">{tech}</li>
          ))}
        </ul>
      </div>
    )}
  </div>
</article>

<style>
  .experience-item {
    position: relative;
    display: flex;
    gap: var(--space-md);
  }

  /* Línea conectora cronológica discreta */
  .timeline-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 16px;
    padding-top: 6px;
  }

  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--color-accent);
    border: 2px solid var(--color-bg-primary);
    z-index: 1;
  }

  .timeline-line {
    width: 2px;
    flex-grow: 1;
    background-color: var(--color-border);
    margin-top: 4px;
    margin-bottom: 4px;
  }

  .experience-item:last-child .timeline-line {
    display: none;
  }

  /* Contenido de la experiencia */
  .experience-content {
    flex-grow: 1;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .experience-item:last-child .experience-content {
    margin-bottom: 0;
  }

  .experience-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .role-title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .company-period {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin: 0;
  }

  .company-name {
    font-weight: var(--font-weight-medium);
    color: var(--color-accent);
  }

  .meta-separator {
    color: var(--color-text-muted);
  }

  .period-text {
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
  }

  /* Responsabilidades */
  .responsibilities-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-left: var(--space-md);
    margin: 0;
    list-style-type: disc;
  }

  .responsibility-item {
    font-size: var(--text-sm);
    line-height: var(--line-height-base);
    color: var(--color-text-secondary);
  }

  .responsibility-item::marker {
    color: var(--color-accent);
  }

  /* Tecnologías asociadas */
  .technologies-container {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .technologies-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tech-chip {
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.6rem;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
  }
</style>
