---
import type { Experience } from '../../types/experience';

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
const isPrimary = Boolean(experience.current);

// Formatear el periodo respetando las precisiones aprobadas
let periodDisplay = '';
if (experience.current) {
  periodDisplay = `${experience.startDate} — Presente`;
} else if (experience.endDate && experience.startDate !== experience.endDate) {
  periodDisplay = `${experience.startDate} — ${experience.endDate}`;
} else {
  periodDisplay = experience.startDate;
}
---

<article class={`experience-item ${isPrimary ? 'is-primary' : 'is-compact'}`}>
  <div class="timeline-indicator" aria-hidden="true">
    <div class="timeline-dot"></div>
    <div class="timeline-line"></div>
  </div>

  <div class="experience-content">
    <header class="experience-header">
      <div class="header-main">
        <div class="role-row">
          <h3 class="role-title">{experience.role}</h3>
          {isPrimary && <span class="current-badge">Actual</span>}
        </div>
        <p class="company-name">{experience.company}</p>
      </div>

      <span class="period-badge">{periodDisplay}</span>
    </header>

    {experience.description && experience.description.length > 0 && (
      <ul class="responsibilities-list">
        {experience.description.map((item) => (
          <li class="responsibility-item">
            <span class="bullet-marker" aria-hidden="true"></span>
            <span class="responsibility-text">{item}</span>
          </li>
        ))}
      </ul>
    )}

    {experience.technologies && experience.technologies.length > 0 && (
      <div class="technologies-container">
        <span class="technologies-label">Tecnologías aplicadas</span>
        <ul class="tech-chips">
          {experience.technologies.map((tech) => (
            <li class="tech-chip">
              <span class="chip-dot" aria-hidden="true"></span>
              <span>{tech}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</article>

<style>
  .experience-item {
    position: relative;
    display: flex;
    gap: clamp(0.85rem, 2.5vw, var(--space-lg));
  }

  /* Conector cronológico */
  .timeline-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 20px;
    padding-top: 1.35rem;
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--color-accent);
    border: 2px solid var(--color-bg-primary);
    box-shadow: 0 0 0 3px var(--color-accent-subtle);
    z-index: 1;
    flex-shrink: 0;
  }

  .timeline-line {
    width: 1px;
    flex-grow: 1;
    background: linear-gradient(
      180deg,
      var(--color-border-subtle) 0%,
      var(--color-border) 100%
    );
    margin-top: 6px;
    margin-bottom: -1.35rem;
  }

  .experience-item:last-child .timeline-line {
    display: none;
  }

  /* Tarjeta Principal (Experiencia Actual) */
  .experience-content {
    flex-grow: 1;
    min-width: 0;
    background: linear-gradient(
      180deg,
      var(--color-bg-surface) 0%,
      var(--color-bg-secondary) 100%
    );
    border: 1px solid var(--color-border-subtle);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    margin-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    box-shadow: var(--shadow-md);
  }

  .experience-item:last-child .experience-content {
    margin-bottom: 0;
  }

  /* Encabezado de la experiencia */
  .experience-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .experience-header {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .header-main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .role-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .role-title {
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .current-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-family-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border);
  }

  .company-name {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .period-badge {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    background-color: rgba(23, 23, 25, 0.65);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.65rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Lista de responsabilidades */
  .responsibilities-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm) var(--space-xl);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (min-width: 860px) {
    .experience-item.is-primary .responsibilities-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .responsibility-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    line-height: var(--line-height-base);
    color: var(--color-text-secondary);
  }

  .bullet-marker {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--color-accent);
    margin-top: 0.55rem;
    flex-shrink: 0;
  }

  /* Tecnologías asociadas */
  .technologies-container {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  @media (min-width: 768px) {
    .technologies-container {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
    }
  }

  .technologies-label {
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tech-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.65rem;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
  }

  .chip-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--color-text-muted);
    flex-shrink: 0;
  }

  /* Variante Compacta y Discreta para Cargos Previos */
  .experience-item.is-compact .timeline-indicator {
    padding-top: 1.1rem;
  }

  .experience-item.is-compact .timeline-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-border-subtle);
    box-shadow: none;
  }

  .experience-item.is-compact .timeline-line {
    margin-bottom: -1.1rem;
  }

  .experience-item.is-compact .experience-content {
    background: rgba(29, 29, 32, 0.55);
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-border-subtle);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-md);
    gap: var(--space-sm);
    box-shadow: none;
  }

  .experience-item.is-compact .experience-header {
    padding-bottom: 0;
    border-bottom: none;
  }

  .experience-item.is-compact .role-title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
  }

  .experience-item.is-compact .company-name {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .experience-item.is-compact .period-badge {
    color: var(--color-text-muted);
    background-color: transparent;
    border-color: var(--color-border);
    padding: 0.2rem 0.5rem;
  }

  .experience-item.is-compact .responsibilities-list {
    gap: 0.3rem;
  }

  .experience-item.is-compact .responsibility-item {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .experience-item.is-compact .bullet-marker {
    width: 4px;
    height: 4px;
    background-color: var(--color-border-subtle);
    margin-top: 0.5rem;
  }
</style>
