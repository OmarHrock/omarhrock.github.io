---
interface Props {
  id: string;
  title?: string;
  eyebrow?: string;
  class?: string;
}

const { id, title, eyebrow, class: className } = Astro.props;
const hasHeader = Boolean(title || eyebrow);
---

<section id={id} class:list={['site-section', className]}>
  <div class="container">
    {hasHeader && (
      <header class="section-header">
        {eyebrow && <span class="section-eyebrow">{eyebrow}</span>}
        {title && (
          <div class="section-title-row">
            <h2 class="section-title">{title}</h2>
            <span class="section-rule" aria-hidden="true"></span>
          </div>
        )}
      </header>
    )}
    <div class="section-content">
      <slot />
    </div>
  </div>
</section>

<style>
  .site-section {
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
    padding-top: clamp(2.75rem, 5.5vw, var(--space-3xl));
    padding-bottom: clamp(2.75rem, 5.5vw, var(--space-3xl));
    border-bottom: 1px solid var(--color-border);
  }

  .site-section:last-of-type {
    border-bottom: none;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: clamp(1.5rem, 3vw, var(--space-xl));
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-family-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .section-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .section-title {
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--line-height-tight);
    color: var(--color-text-primary);
    margin: 0;
    flex-shrink: 0;
  }

  .section-rule {
    height: 1px;
    flex-grow: 1;
    background: linear-gradient(
      90deg,
      var(--color-border-subtle) 0%,
      rgba(62, 62, 68, 0.12) 100%
    );
  }

  .section-content {
    width: 100%;
  }
</style>
