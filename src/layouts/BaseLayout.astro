---
import '../styles/variables.css';
import '../styles/global.css';
import '../styles/utilities.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import BackToTop from '../components/common/BackToTop.astro';
import { siteMetadata } from '../data/site';
import { socialLinks } from '../data/social';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteMetadata.title,
  description = siteMetadata.description,
} = Astro.props;

const canonicalURL = siteMetadata.url;

const linkedInLink = socialLinks.find((s) => s.name.toLowerCase() === 'linkedin')?.url;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteMetadata.author,
  url: siteMetadata.url,
  jobTitle: 'Software Developer',
  sameAs: linkedInLink ? [linkedInLink] : [],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteMetadata.author} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteMetadata.url} />
    <meta property="og:site_name" content={siteMetadata.siteName} />
    <meta property="og:locale" content={siteMetadata.locale} />
    <meta property="og:image" content={siteMetadata.ogImage.url} />
    <meta property="og:image:width" content={String(siteMetadata.ogImage.width)} />
    <meta property="og:image:height" content={String(siteMetadata.ogImage.height)} />
    <meta property="og:image:alt" content={siteMetadata.ogImage.alt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteMetadata.ogImage.url} />
    <meta name="twitter:image:alt" content={siteMetadata.ogImage.alt} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
